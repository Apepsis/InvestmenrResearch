{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "investment-market-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://apepsis.github.io,http://localhost:5173",
    "ALLOWED_SYMBOLS": "UBER,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM,BAC,GS,JNJ,UNH,LLY,PFE,XOM,CVX,WMT,COST,HD,MCD,NKE,CAT,GE,UPS,AMD,INTC,ORCL,CRM,ADBE,DIS,NFLX,SPY"
  }
}
